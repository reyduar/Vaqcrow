# Docker profile — local Supabase (CLI-managed containers) + apps/api built
# and run from apps/api/Dockerfile via docker-compose.local.yml, Stellar
# Quickstart in Docker Desktop for contract work. This is the local-testing
# profile: APP_ENV=local, and every value below is a real local default —
# nothing here is a production secret.
#
# You do not normally hand-edit `.env.docker` at the repository root:
# `scripts/env/generate-docker-env.sh` writes it from the running local
# Supabase stack plus the LLM_* lines copied from `.env.cloud`. This file is
# a reference of what ends up in it, and a fallback if you need to write one
# by hand. `.env.docker` is gitignored; this `.example` file is not.
#
# See docs/architecture/environments.md for the full profile comparison and
# first-time setup.

# --- Runtime -------------------------------------------------------------
APP_ENV=local
PORT=3000
LOG_LEVEL=info

# --- Stellar ---------------------------------------------------------------
# Without a local deployment, `scripts/env/generate-docker-env.sh` writes
# STELLAR_NETWORK=testnet — the API only accepts "testnet" in that mode. After
# `pnpm env:docker:bootstrap`, the same script writes the local block instead:
# STELLAR_NETWORK=local, STELLAR_HORIZON_URL, STELLAR_RPC_URL,
# STELLAR_CAMPAIGN_FACTORY_ID and STELLAR_TOKEN_CONTRACT_ID, and reads
# STELLAR_PLATFORM_SECRET_KEY from the `vaqcrow-platform` keystore identity
# without ever printing it.
#
# Walkthrough: docs/architecture/environments.md §11.
STELLAR_NETWORK=testnet

# --- Supabase (local CLI stack) --------------------------------------------
# 127.0.0.1 is correct when apps/api runs on the host (`pnpm --filter
# @vaqcrow/api dev`). Inside the api container, docker-compose.local.yml
# overrides this to http://host.docker.internal:54321, because 127.0.0.1
# inside the container refers to the container itself, not the host running
# Supabase.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service-role-key from `supabase status -o env`>
SUPABASE_PUBLISHABLE_KEY=<publishable-key (or anon-key) from `supabase status -o env`>

# --- LLM (opencode-go, advisory assessment only) ---------------------------
# The docker profile has no LLM credential of its own — it reuses the demo
# one from .env.cloud verbatim (generate-docker-env.sh copies these lines).
LLM_PROVIDER=opencode-go
LLM_MODEL=<model-id>
LLM_API_KEY=<llm-api-key>
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=

# --- Web (apps/web reads only this one) -------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
