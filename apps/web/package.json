{
  "name": "@vaqcrow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:docker": "node --env-file=../../.env.docker ./node_modules/next/dist/bin/next dev --port 3001",
    "dev:cloud": "node --env-file=../../.env.cloud ./node_modules/next/dist/bin/next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@stellar/freighter-api": "^6.0.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vaqcrow/contracts": "workspace:*",
    "axios": "^1.20.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "swr": "^2.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.63.0",
    "@stellar/stellar-sdk": "^17.1.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "catalog:",
    "eslint-config-next": "^16.3.5",
    "globals": "catalog:",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^7.3.6",
    "vitest": "catalog:"
  }
}
