{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/**/*",
    "e2e/**/*.ts",
    "e2e-live/**/*.ts",
    "playwright.config.ts",
    "playwright.live.config.ts",
    "vitest.setup.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ]
}
