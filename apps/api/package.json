{
  "name": "@vaqcrow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/index.js)",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "@supabase/supabase-js": "2.116.0",
    "@vaqcrow/ai": "workspace:*",
    "@vaqcrow/contracts": "workspace:*",
    "@vaqcrow/domain": "workspace:*",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "7.3.6",
    "vitest": "catalog:"
  }
}
