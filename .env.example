# Supabase (apps/api persistence layer)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# API process. Validated at startup: a missing or out-of-scope value stops the
# process with every offending key listed.
# APP_ENV: local | ci | preview | demo  (production is out of scope for this demo)
APP_ENV=local
PORT=3000
LOG_LEVEL=info

# Stellar. Testnet only — the public network is rejected at startup.
STELLAR_NETWORK=testnet
# Optional. Defaults to https://horizon-testnet.stellar.org; a loopback host is
# accepted for a local Horizon double.
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# LLM provider (apps/api assessment boundary). All three of these are required:
# a missing or unrecognised value stops the process at startup, listing every
# offending key at once and echoing none of their values.
LLM_PROVIDER=opencode-go
# The bare model id from the provider's live list — NOT the `opencode-go/<id>`
# form used by OpenCode's own config. Fetch the list with:
#   curl https://opencode.ai/zen/go/v1/models
# Measured on 2026-09-22: glm-5.3-flash returned a schema-valid assessment with
# no invented references in 5.6 s, the fastest and cheapest of the seven models
# tried (deepseek-v4-pro took 39.5 s). See odd/tasks/llm-provider-configuration-and-model-selection.md
LLM_MODEL=glm-5.3-flash
# Secret. Never commit a real value; set it locally and in the deploy service.
LLM_API_KEY=
# Optional. Defaults to https://opencode.ai/zen/go/v1; a loopback host is
# accepted over http for a local provider double.
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# Optional. Defaults to 15000, bounded to 1000..120000.
# LLM_TIMEOUT_MS=15000
