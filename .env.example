# Supabase (apps/api persistence layer)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# API process. Validated at startup: a missing or out-of-scope value stops the
# process with every offending key listed.
# APP_ENV: local | ci | preview | demo  (production is out of scope for this demo)
APP_ENV=local
PORT=3000
LOG_LEVEL=info

# Stellar. Testnet only — the public network is rejected at startup.
STELLAR_NETWORK=testnet
# Optional. Defaults to https://horizon-testnet.stellar.org; a loopback host is
# accepted for a local Horizon double.
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
