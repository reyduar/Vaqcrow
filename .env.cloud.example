# Cloud profile — Supabase remote, apps/api hosted on Railway, apps/web on
# Vercel, Stellar Testnet. This is the demo profile: APP_ENV=demo, and every
# credential here is a real one issued for the demo project, never a local
# placeholder.
#
# Copy this file to `.env.cloud` at the repository root and fill in the
# placeholders. `.env.cloud` is gitignored; this `.example` file is not.
#
# Consumers: `apps/api` reads these via `node --env-file=.env.cloud` (see
# `apps/api` `dev:cloud` / `test:integration:cloud` scripts) and
# `packages/ai/scripts/bake-off-llm.mjs`. `apps/web` never reads this file
# directly — see `.env.docker.example` for the browser-facing variable.
#
# See docs/architecture/environments.md for the full profile comparison and
# first-time setup.

# --- Runtime -------------------------------------------------------------
APP_ENV=demo
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# --- Stellar ---------------------------------------------------------------
# Only "testnet" is accepted; the API rejects "public" at startup by design.
STELLAR_NETWORK=testnet
# Optional overrides — leave unset to use the built-in Testnet Horizon/
# Explorer constants.
# STELLAR_HORIZON_URL=
# STELLAR_EXPLORER_URL=

# Campaign vault (Soroban factory). The API parses these keys on startup.
# STELLAR_CAMPAIGN_FACTORY_ID and STELLAR_PLATFORM_SECRET_KEY are a pair:
#   - neither set  -> the vault resolves to disabled and the campaign routes
#                     are not registered at all;
#   - only one set -> the API fails loudly at startup (they are required
#                     together).
# The factory id is a public contract address; the platform secret signs
# factory.deploy() on the platform's behalf.
STELLAR_CAMPAIGN_FACTORY_ID=<factory-id>
STELLAR_PLATFORM_SECRET_KEY=<platform-secret-key>
# Optional — leave unset to let the API derive the native XLM SAC from the
# network passphrase (STELLAR_TOKEN_CONTRACT_ID) and fall back to the built-in
# Testnet RPC (STELLAR_RPC_URL).
# STELLAR_TOKEN_CONTRACT_ID=
# STELLAR_RPC_URL=
#
# Where the secret comes from: the `vaqcrow-testnet` identity in the Stellar
# CLI keystore, retrieved by the operator with
#   stellar keys secret vaqcrow-testnet
# The value is never committed to this repository.
#
# This file is NOT the deployment mechanism. For the hosted API, set the same
# keys as service variables in the Railway panel (see
# docs/architecture/environments.md, section 7).

# --- Supabase (remote project) --------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional — the API does not serve the browser, so this is rarely needed
# here; the web app gets its own Supabase access through packages/contracts.
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- LLM (opencode-go, advisory assessment only) ---------------------------
LLM_PROVIDER=opencode-go
LLM_MODEL=<model-id>
LLM_API_KEY=<llm-api-key>
LLM_VISION_MODEL=<vision-model-id>
# Optional overrides.
# LLM_BASE_URL=
LLM_TIMEOUT_MS=120000
# --- Email (Resend HTTP API, optional) --------------------------------------
# The admin's "new application" email — the counterpart of the in-app bell.
# Without RESEND_API_KEY the API treats email as DISABLED, not misconfigured:
# a send reports unavailable and the action still completes, so an unset key is
# a silent no-email, never a boot failure. This file is NOT the deployment
# mechanism — for the hosted API these live in the Railway panel (see
# docs/architecture/environments.md, §7). Uncomment all three together to turn
# delivery on: APP_BASE_URL is REQUIRED once the key is present outside `local`,
# and the API refuses to boot with a missing or invalid one, so email links
# never fall back to loopback. EMAIL_FROM defaults to the verified Resend sender;
# the SMTP that Supabase Auth uses for account confirmation is a different slice
# (§13/§14) that happens to share the same sender.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=Vaqcrow <no-reply@vaqcrow.com>
APP_BASE_URL=https://<hosted-web-origin>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=