{
  "name": "vaqcrow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "depcruise apps/*/src packages/*/src --config .dependency-cruiser.cjs",
    "test:boundaries": "vitest run",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run boundaries && pnpm run test:boundaries",
    "install:verify": "pnpm install --frozen-lockfile",
    "workspaces:list": "pnpm -r list --depth -1"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "dependency-cruiser": "^16.0.0",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "globals": "catalog:",
    "vitest": "catalog:",
    "eslint-config-next": "^16.3.5",
    "@vaqcrow/contracts": "workspace:*",
    "@vaqcrow/domain": "workspace:*"
  }
}
